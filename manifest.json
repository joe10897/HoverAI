{
  "manifest_version": 3,
  "name": "Hover AI Reader - 網頁懸停即時重點解析助手",
  "version": "1.1.0",
  "description": "滑鼠懸停即可即時解析網頁段落重點，免切換分頁、不中斷閱讀動線，支援自訂極簡透明浮動顯示。",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hover AI 設定"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ]
}